{
  "builds": [
    {
      "src": "api.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(search|detail|home).*",
      "dest": "api.py"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
